# Required at build time. Without both values, `npm run build` still succeeds, but the
# popup shows a setup message instead of mounting sign-in (a missing URL used to throw
# during import and leave a blank white panel). Replace the placeholders before a store build.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=https://app.posthog.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# ExtensionPay extension id. The permanent id is gofillr-admin. Not a Stripe secret.
# ExtPay mints a per-install API key at runtime and stores it in chrome.storage.sync
# — never commit that key.
# Dashboard plan nicknames this client sends: pro-monthly ($5.99/mo), pro-yearly ($49/yr).
VITE_EXTENSIONPAY_EXTENSION_ID=gofillr-admin
# Sent as X-API-Key on POST /api/v1/billing/plan, Pro AI calls, and Match Score.
# Upload/parse does not send it. Never commit a live key.
VITE_RESUME_API_KEY=
# Resume API base, including /api/v1. Production origin is
# https://api-production-5aca1.up.railway.app. Unset uses http://localhost:8080/api/v1.
# Match Score uses this same base. Do not hardcode the origin in the client.
# VITE_RESUME_API_URL=https://api-production-5aca1.up.railway.app/api/v1
# Match Score. Unset uses the defaults: on for Greenhouse, Ashby, Lever, and Workable.
# Jobvite stays off (no confirmed public posting host). BambooHR, iCIMS, and Workday stay off.
# VITE_MATCH_SCORE_ENABLED=true
# VITE_MATCH_SCORE_GREENHOUSE=true
# VITE_MATCH_SCORE_ASHBY=true
# VITE_MATCH_SCORE_LEVER=true
# VITE_MATCH_SCORE_WORKABLE=true
# VITE_MATCH_SCORE_JOBVITE=false
# VITE_MATCH_SCORE_BAMBOOHR=false
# VITE_MATCH_SCORE_ICIMS=false
# VITE_MATCH_SCORE_WORKDAY=false
# Not used by the Vite build (no VITE_ prefix). Client ID also goes in manifest.json;
# the secret belongs only in the Supabase dashboard (Auth > Providers > Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
