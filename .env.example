# Required at build time. Without both values, `npm run build` still succeeds, but the
# popup shows a setup message instead of mounting sign-in (a missing URL used to throw
# during import and leave a blank white panel). Replace the placeholders before a store build.
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=https://app.posthog.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Not used by the Vite build (no VITE_ prefix). Client ID also goes in manifest.json;
# the secret belongs only in the Supabase dashboard (Auth > Providers > Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
