{
  "manifest_version": 3,
  "name": "GoFillr - Job Application Autofill",
  "key": "",
  "version": "2.0.0",
  "description": "Autofill job applications from one saved profile. Enter your details once and fill supported hiring sites in a click.",
  "permissions": ["storage", "activeTab", "scripting", "identity"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.eu.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkday.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.workday.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.bamboohr.com/*",
    "https://*.icims.com/*",
    "https://*.jobvite.com/*",
    "https://*.apply.workable.com/*",
    "https://apply.workable.com/*",
    "https://gofillr.com/*",
    "https://www.gofillr.com/*",
    "https://chromewebstore.google.com/*",
    "https://chrome.google.com/*",
    "https://extensionpay.com/*",
    "https://api.mixpanel.com/*",
    "https://api-js.mixpanel.com/*",
    "https://*.supabase.co/*",
    "https://api-production-5aca1.up.railway.app/*",
    "https://api.eu.lever.co/*",
    "https://www.workable.com/*"
  ],
  "oauth2": {
    "client_id": "628494525589-8i2v9kg3hdgil3tqoo1oesmooa8ofi37.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://extensionpay.com https://api.mixpanel.com https://api-js.mixpanel.com https://*.supabase.co https://api-production-5aca1.up.railway.app https://boards-api.greenhouse.io https://api.lever.co https://api.eu.lever.co https://api.ashbyhq.com https://apply.workable.com https://www.workable.com"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "autofill-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Auto-fill the current job application"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://extensionpay.com/*"],
      "js": ["extensionPayContent.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.eu.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.workday.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.apply.workable.com/*",
        "https://apply.workable.com/*",
        "https://gofillr.com/*",
        "https://www.gofillr.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "assets/images/*"],
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.eu.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkday.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.workday.com/*",
        "https://*.ashbyhq.com/*",
        "https://*.bamboohr.com/*",
        "https://*.icims.com/*",
        "https://*.jobvite.com/*",
        "https://*.apply.workable.com/*",
        "https://apply.workable.com/*",
        "https://gofillr.com/*",
        "https://www.gofillr.com/*",
        "https://extensionpay.com/*"
      ]
    }
  ]
}
